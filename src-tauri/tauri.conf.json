{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-desk",
  "version": "0.1.11",
  "identifier": "com.pine-storm.ai-desk",
  "build": {
    "beforeDevCommand": "pnpm build:pi-sidecar && pnpm web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:pi-sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ai-desk",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 18 },
        "hiddenTitle": true,
        "backgroundColor": "#16181b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; img-src 'self' asset: https://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/pi"],
    "resources": {
      "resources/pi-runtime/": "pi-runtime/"
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "category": "DeveloperTool",
    "shortDescription": "A local desktop UI for pi-coding-agent",
    "longDescription": "A native desktop interface for browsing and presenting local Pi coding-agent sessions."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczNzY2MDBEMkFEODFBMUMKUldRY0d0Z3FEV0IyYzQ3WDVwM3RRb0I5L2l6Y1gxdlhyMTB4MFFVUFJIYjUzNDlzUSt2M1d6ZWgK",
      "endpoints": [
        "https://github.com/yuguaa/ai-desk/releases/latest/download/latest.json"
      ]
    }
  }
}
